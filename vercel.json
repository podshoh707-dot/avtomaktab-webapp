{
  "version": 2,
  "functions": {
    "api/duel/create.js": { "memory": 256, "maxDuration": 10 },
    "api/duel/join.js":   { "memory": 256, "maxDuration": 10 },
    "api/duel/state.js":  { "memory": 256, "maxDuration": 10 },
    "api/duel/answer.js": { "memory": 256, "maxDuration": 10 }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    {
      "src": "/(.*)",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
